# App
APP_VERSION=0.1.0
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/satva

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://yourdomain.com

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TO=admin@example.com

# Cloudflare Turnstile (капча). Site key также отдаётся в GET /api/public-config
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Policy version for consent records
POLICY_VERSION=2026-01-01
