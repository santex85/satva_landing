# App
APP_VERSION=0.1.0
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/satva

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://yourdomain.com

# --- SMTP: уведомления о новых заявках (contact / booking / package-request) ---
# Обязательно для отправки: SMTP_HOST и SMTP_TO. Без них письма не шлутся, заявка всё равно в БД.
#
# Частые варианты:
# • Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, PORT=587, пароль — "App Password" (не от аккаунта).
# • Яндекс 360 / Почта: smtp.yandex.ru:465 — поставьте SMTP_USE_SSL=true или PORT=465.
# • Mail.ru: smtp.mail.ru, порт 587 + TLS или 465 + SSL.
# • Отправка на несколько адресов: SMTP_TO=admin@site.com,backup@site.com
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Адрес отправителя (должен быть разрешён у провайдера; часто совпадает с SMTP_USER)
SMTP_FROM=
# Кому слать копии заявки (через запятую без пробелов или с пробелами — оба работают)
SMTP_TO=
# true — соединение сразу по TLS (типично порт 465). Порт 465 распознаётся автоматически.
SMTP_USE_SSL=false

# Cloudflare Turnstile (капча). Site key отдаётся в GET /api/public-config.
# При открытии сайта с Host localhost / 127.0.0.1 проверка на бэкенде отключается (локальная разработка).
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Policy version for consent records
POLICY_VERSION=2026-01-01
