# App
APP_VERSION=0.1.0
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/satva

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://yourdomain.com

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TO=admin@example.com

# amoCRM (v4)
AMOCRM_SUBDOMAIN=your-subdomain
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_ACCESS_TOKEN=
AMOCRM_REFRESH_TOKEN=

# Policy version for consent records
POLICY_VERSION=2026-01-01
