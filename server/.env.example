# App
APP_VERSION=0.1.0
DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/satva

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://satvasamui.com,https://www.satvasamui.com

# --- Resend: email-уведомления о новых заявках ---
# Без RESEND_API_KEY письма не шлются (заявка всё равно сохраняется в БД).
# 1) Получить ключ: https://resend.com/api-keys
# 2) Подтвердить домен отправителя в Resend (DNS): https://resend.com/domains
RESEND_API_KEY=
# Имя и адрес отправителя (домен должен быть подтверждён в Resend):
RESEND_FROM=Satva Samui <hello@satvasamui.com>
# Кому слать уведомления — один или несколько адресов через запятую:
RESEND_TO=

# Tawk.to Inbox: «Ticket forwarding email» из Dashboard → Administration → Overview.
# Каждая заявка с сайта уходит письмом на этот адрес и появляется отдельным тикетом.
TAWK_TICKET_FORWARD_EMAIL=

# Tawk JavaScript API key (Dashboard → Administration → Overview → JavaScript API).
# Включите Secure Mode и задайте ключ — телефон будет в поле Contact через login().
TAWK_JS_API_KEY=

# Cloudflare Turnstile (капча). Site key отдаётся в GET /api/public-config.
# При открытии сайта с Host localhost / 127.0.0.1 проверка на бэкенде отключается (локальная разработка).
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Policy version for consent records
POLICY_VERSION=2026-05-29

# Umami Cloud analytics (admin dashboard proxy)
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=0cc0f862-5822-4abc-bf47-1c8a8af4ac22
UMAMI_API_BASE=https://api.umami.is/v1
